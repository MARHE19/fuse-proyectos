---
import { Image } from "astro:assets";
import whatsappIcon from "../assets/images/whatsapp-icon.svg";
const numero = "51921616745";
const mensaje = "Hola, quiero más información sobre sus servicios";
const url = `https://wa.me/${numero}?text=${encodeURIComponent(mensaje)}`;
---

<a
    href={url}
    target="_blank"
    rel="noopener noreferrer"
    aria-label="Escríbenos por WhatsApp"
    class="fixed bottom-6 right-6 z-50 flex items-center justify-center w-14 h-14 rounded-full bg-green-500 hover:bg-green-600 shadow-lg hover:scale-110 transition-all duration-300"
>
    <Image src={whatsappIcon} alt="WhatsApp" width={32} height={32} />
</a>
