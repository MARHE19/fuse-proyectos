---
// src/components/Hero.astro
import { Image } from "astro:assets";
import edificio1 from "../assets/images/edificio1.jpg";
import edificio2 from "../assets/images/edificio2.jpg";
import edificio3 from "../assets/images/edificio3.jpg";

const slides = [
    { img: edificio1, text: "Trabajamos en todo el Perú" },
    { img: edificio2, text: "Ingeniería y construcción con experiencia" },
    { img: edificio3, text: "Convertimos tu proyecto en realidad" },
];
---

<section id="hero" class="relative w-full h-screen overflow-hidden">
    <!-- Slides -->
    <div id="carousel" class="relative w-full h-full">
        {slides.map((slide, i) => (
            <div
                class="carousel-slide absolute inset-0 transition-opacity duration-700 ease-in-out"
                class:list={[i === 0 ? "opacity-100" : "opacity-0 pointer-events-none"]}
                data-index={i}
            >
                <Image
                    src={slide.img}
                    alt={`Fuse Proyectos - obra ${i + 1}`}
                    class="w-full h-full object-cover"
                    width={1600}
                    height={900}
                />
                <div class="absolute inset-0 bg-fuse-navy/60"></div>

                <div class="absolute inset-0 flex flex-col items-center justify-center text-center px-6">
                    <p class="slide-text text-fuse-orange text-2xl md:text-4xl font-bold mb-6 opacity-0 translate-y-4 transition-all duration-700">
                        {slide.text}
                    </p>
                    <a
                        href="#contacto"
                        class="bg-fuse-orange hover:bg-orange-600 text-white px-8 py-3 rounded-lg font-semibold text-lg transition-colors"
                    >
                        Contáctame
                    </a>
                </div>
            </div>
        ))}
    </div>

    <!-- Flecha izquierda -->
    <button
        id="prev-btn"
        aria-label="Anterior"
        class="absolute left-4 top-1/2 -translate-y-1/2 text-white rounded-full p-3 bg-white/10 hover:bg-white/25 backdrop-blur-sm transition-colors z-10"
    >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
    </button>

    <!-- Flecha derecha -->
    <button
        id="next-btn"
        aria-label="Siguiente"
        class="absolute right-4 top-1/2 -translate-y-1/2 text-white rounded-full p-3 bg-white/10 hover:bg-white/25 backdrop-blur-sm transition-colors z-10"
    >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
    </button>

    <!-- Indicadores -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 flex gap-2 z-10">
        {slides.map((_, i) => (
            <button
                class="dot w-2.5 h-2.5 rounded-full bg-white/50 transition-colors"
                data-index={i}
                aria-label={`Ir a slide ${i + 1}`}
            ></button>
        ))}
    </div>
</section>

<script>
    const slidesEls = document.querySelectorAll<HTMLElement>(".carousel-slide");
    const dots = document.querySelectorAll<HTMLElement>(".dot");
    const prevBtn = document.getElementById("prev-btn");
    const nextBtn = document.getElementById("next-btn");

    let current = 0;
    const total = slidesEls.length;

    function showSlide(index: number) {
        slidesEls.forEach((slide, i) => {
            const text = slide.querySelector(".slide-text");
            if (i === index) {
                slide.classList.remove("opacity-0", "pointer-events-none");
                slide.classList.add("opacity-100");
                setTimeout(() => {
                    text?.classList.remove("opacity-0", "translate-y-4");
                    text?.classList.add("opacity-100", "translate-y-0");
                }, 200);
            } else {
                slide.classList.add("opacity-0", "pointer-events-none");
                slide.classList.remove("opacity-100");
                text?.classList.add("opacity-0", "translate-y-4");
                text?.classList.remove("opacity-100", "translate-y-0");
            }
        });

        dots.forEach((dot, i) => {
            dot.classList.toggle("bg-white", i === index);
            dot.classList.toggle("bg-white/50", i !== index);
        });

        current = index;
    }

    function nextSlide() {
        showSlide((current + 1) % total);
    }

    function prevSlide() {
        showSlide((current - 1 + total) % total);
    }

    nextBtn?.addEventListener("click", nextSlide);
    prevBtn?.addEventListener("click", prevSlide);

    dots.forEach((dot) => {
        dot.addEventListener("click", () => {
            const index = parseInt(dot.dataset.index || "0");
            showSlide(index);
        });
    });

    setInterval(nextSlide, 6000);

    showSlide(0);
</script>
