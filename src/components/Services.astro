---
// src/components/Services.astro
const servicios = [
    {
        titulo: "Instalaciones Eléctricas",
        descripcion:
            "Realizamos instalaciones eléctricas para casas, locales, fábricas y otros establecimientos, incluyendo sistemas de baja tensión (BT), tableros principales y de distribución AC, señalización, sistemas de energía ininterrumpida (UPS) y estabilizadores, sistemas de puesta a tierra, grupos electrógenos, proyectos de ahorro de energía, automatización industrial y servicios de electricidad general.",
    },
    {
        titulo: "Implementación de Sistemas de Pozos a Tierra y Pararrayos",
        descripcion:
            "Realizamos la construcción de pozos a tierra según la Norma Técnica Peruana NTP 370.052 / 053, así como el mantenimiento de pozos a tierra estándar con valores menores a 5 ohmios y la instalación de mallas a tierra. Emitimos certificados de pozos a tierra firmados por ingeniero eléctrico colegiado. Además, ofrecemos venta, instalación y mantenimiento de pararrayos PDC y pararrayos con dispositivo de cebado.",
    },
    {
        titulo: "Cableado Estructurado con Normas y Estándares",
        descripcion:
            "Realizamos canalización de tubería conduit y bandejas eléctricas, instalación de tableros de instrumentación y tableros de distribución, instalación de instrumentos y sensores en campo, así como conexiones en tableros de instrumentación.",
    },
    {
        titulo: "Mantenimiento Preventivo y Correctivo",
        descripcion:
            "Realizamos mantenimiento de tableros eléctricos, subestaciones y bancos de condensadores, así como mantenimiento residencial, comercial e industrial de instalaciones eléctricas en baja tensión (BT) y media tensión (MT). También ofrecemos mantenimiento preventivo y correctivo de sistemas eléctricos y ejecución y mantenimiento de sistemas de puesta a tierra.",
    },
    {
        titulo: "Pintado en General",
        descripcion:
            "Realizamos servicios de mantenimiento y pintura para empresas, casas, edificios, departamentos y oficinas, incluyendo empaste, sellado y pintura de todo tipo de superficies. Ofrecemos pintura interior y exterior, mantenimiento de pintura, pintado de paredes y edificios, pintura en general, servicios de pintores, pintura para oficinas y empresas, pintura de departamentos tanto interior como exterior, y servicios de pintura industrial.",
    },
];

// Datos estructurados Schema.org (JSON-LD) para cada servicio.
// Usa las mismas variables de arriba, así que cuando cambies los
// textos reales, este schema se actualiza automáticamente.
const servicesSchema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: servicios.map((servicio, i) => ({
        "@type": "Service",
        position: i + 1,
        name: servicio.titulo,
        description: servicio.descripcion,
        provider: {
            "@type": "LocalBusiness",
            name: "Fuse Proyectos",
        },
    })),
};
---

<section id="servicios" class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-fuse-navy">
                Nuestros Servicios
            </h2>
            <div class="w-20 h-1 bg-fuse-orange mx-auto mt-4"></div>
        </div>

        <ul class="grid grid-cols-1 md:grid-cols-3 gap-8 list-none p-0 m-0">
            {
                servicios.map((servicio) => (
                    <li class="bg-fuse-gray rounded-xl p-8 hover:shadow-lg transition-shadow border-t-4 border-fuse-orange">
                        <h3 class="text-xl font-semibold text-fuse-navy mb-4">
                            {servicio.titulo}
                        </h3>
                        <p class="text-slate-600 leading-relaxed">
                            {servicio.descripcion}
                        </p>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />
