---
// src/components/Services.astro
import { Image } from "astro:assets";
import personaje from "../assets/images/personaje.webp";

const servicios = [
    {
        titulo: "Instalaciones Eléctricas",
        puntos: [
            "Instalaciones eléctricas para casas, locales, fábricas, etc.",
            "BT (tablero principal y de distribución AC), señalización.",
            "Sistema de energía ininterrumpida (UPS, estabilizadores).",
            "Sistema de puesta a tierra.",
            "Grupos electrógenos.",
            "Proyectos de ahorro de energía.",
            "Automatización industrial.",
            "Electricidad general.",
        ],
    },
    {
        titulo: "Implementación de Sistemas de Pozos a Tierra y Pararrayos",
        puntos: [
            "Construcción de Pozo a Tierra según Norma Técnica Peruana NTP 370.052 / 053.",
            "Mantenimiento de Pozo a Tierra.",
            "Pozo a Tierra Estándar: pozos de menos de 5 ohmios, mallas a tierra.",
            "Certificado de Pozos a Tierra firmado por Ingeniero Eléctrico Colegiado.",
            "Venta, instalación y mantenimiento de pararrayos PDC y pararrayos con dispositivo de cebado.",
        ],
    },
    {
        titulo: "Cableado Estructurado con Normas y Estándares",
        puntos: [
            "Canalización de tubería conduit.",
            "Canalización de bandejas eléctricas.",
            "Instalación de tablero de instrumentación.",
            "Instalación de tablero de distribución.",
            "Instalación de instrumentos y sensores en campo.",
            "Conexión en tablero de instrumentación.",
        ],
    },
    {
        titulo: "Mantenimiento Preventivo y Correctivo",
        puntos: [
            "Mantenimiento de tableros eléctricos.",
            "Mantenimiento de subestaciones.",
            "Mantenimiento de banco de condensadores.",
            "Mantenimiento residencial, comercial e industrial de instalaciones eléctricas en BT y MT.",
            "Mantenimiento preventivo y correctivo S.S.E.E.",
            "Ejecución y mantenimiento de puesta a tierra.",
        ],
    },
    {
        titulo: "Pintado en General",
        puntos: [
            "Mantenimiento de pintura para empresas, casas, edificios, departamentos, oficinas.",
            "Empaste, sellado y pintura de toda superficie.",
            "Servicio de pintura interior y exterior.",
            "Servicio de mantenimiento de pintura.",
            "Servicio de pintura para interiores.",
            "Servicios de pintura en general.",
            "Servicio de pintores.",
            "Servicio de pintado de edificios.",
            "Servicio de pintado de paredes.",
        ],
    },
];

// Datos estructurados Schema.org (JSON-LD) para cada servicio.
// La descripción se arma uniendo las viñetas, así que si cambias los
// puntos de arriba, el schema se actualiza automáticamente.
const servicesSchema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: servicios.map((servicio, i) => ({
        "@type": "Service",
        position: i + 1,
        name: servicio.titulo,
        description: servicio.puntos.join(". "),
        provider: {
            "@type": "LocalBusiness",
            name: "Fuse Proyectos",
        },
    })),
};
---

<section id="servicios" class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-fuse-navy">
                Nuestros Servicios
            </h2>
            <div class="w-20 h-1 bg-fuse-orange mx-auto mt-4"></div>
        </div>

        <ul class="grid grid-cols-1 md:grid-cols-3 gap-8 list-none p-0 m-0">
            {
                servicios.map((servicio) => (
                    <li class="bg-fuse-gray rounded-xl p-8 hover:shadow-lg transition-shadow border-t-4 border-fuse-orange">
                        <h3 class="text-xl font-semibold text-fuse-navy mb-4">
                            {servicio.titulo}
                        </h3>
                        <ul class="space-y-2">
                            {servicio.puntos.map((punto) => (
                                <li class="flex gap-2 text-slate-600 leading-relaxed">
                                    <span class="text-fuse-orange font-bold shrink-0">
                                        •
                                    </span>
                                    <span>{punto}</span>
                                </li>
                            ))}
                        </ul>
                    </li>
                ))
            }

            <!-- Personaje Fuse en el espacio vacío de la grilla -->
            <li
                class="hidden md:flex items-end justify-center"
                aria-hidden="true"
            >
                <Image
                    src={personaje}
                    alt="Personaje Fuse Proyectos"
                    class="w-full h-full max-h-[420px] object-contain"
                    width={500}
                    height={500}
                />
            </li>
        </ul>
    </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />
