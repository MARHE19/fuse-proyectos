---
// src/components/Services.astro
const servicios = [
    {
        titulo: "Acondicionamiento de Edificios",
        descripcion:
            "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent facilisis, nunc ut fermentum congue, arcu sapien luctus justo.",
    },
    {
        titulo: "Arquitectura e Ingeniería",
        descripcion:
            "Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat, duis aute irure.",
    },
    {
        titulo: "Construcción de Edificios",
        descripcion:
            "Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Excepteur sint occaecat cupidatat non proident, sunt.",
    },
];

// Datos estructurados Schema.org (JSON-LD) para cada servicio.
// Usa las mismas variables de arriba, así que cuando cambies los
// textos reales, este schema se actualiza automáticamente.
const servicesSchema = {
    "@context": "https://schema.org",
    "@type": "ItemList",
    itemListElement: servicios.map((servicio, i) => ({
        "@type": "Service",
        position: i + 1,
        name: servicio.titulo,
        description: servicio.descripcion,
        provider: {
            "@type": "LocalBusiness",
            name: "Fuse Proyectos",
        },
    })),
};
---

<section id="servicios" class="py-24 px-6 bg-white">
    <div class="max-w-6xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-bold text-fuse-navy">
                Nuestros Servicios
            </h2>
            <div class="w-20 h-1 bg-fuse-orange mx-auto mt-4"></div>
        </div>

        <ul class="grid grid-cols-1 md:grid-cols-3 gap-8 list-none p-0 m-0">
            {
                servicios.map((servicio) => (
                    <li class="bg-fuse-gray rounded-xl p-8 hover:shadow-lg transition-shadow border-t-4 border-fuse-orange">
                        <h3 class="text-xl font-semibold text-fuse-navy mb-4">
                            {servicio.titulo}
                        </h3>
                        <p class="text-slate-600 leading-relaxed">
                            {servicio.descripcion}
                        </p>
                    </li>
                ))
            }
        </ul>
    </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(servicesSchema)} />
