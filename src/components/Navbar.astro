---
// src/components/Navbar.astro
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";
---

<header
    class="fixed top-0 left-0 w-full bg-white/95 backdrop-blur-sm shadow-sm z-50"
>
    <nav class="max-w-6xl mx-auto px-6 py-4 flex items-center justify-between">
        <!-- Logo + Nombre -->
        <a href="#hero" class="flex items-center gap-3">
            <Image
                src={logo}
                alt="Fuse Proyectos - Ingeniería y Construcción"
                width={128}
                height={128}
                class="h-16 md:h-20 w-auto object-contain"
            />
            <span class="text-lg font-bold text-fuse-navy">
                FUSE <span class="text-fuse-orange"
                    >Proyectos Ingenieria y Construcción</span
                >
            </span>
        </a>

        <!-- Enlaces (desktop) -->
        <ul
            class="hidden md:flex items-center gap-8 text-sm font-medium text-fuse-navy"
        >
            <li>
                <a href="#hero" class="hover:text-fuse-orange transition-colors"
                    >Inicio</a
                >
            </li>
            <li>
                <a
                    href="#servicios"
                    class="hover:text-fuse-orange transition-colors"
                    >Servicios</a
                >
            </li>
            <li>
                <a
                    href="#portafolio"
                    class="hover:text-fuse-orange transition-colors"
                    >Portafolio</a
                >
            </li>
            <li>
                <a
                    href="#contacto"
                    class="hover:text-fuse-orange transition-colors">Contacto</a
                >
            </li>
        </ul>

        <!-- Botón menú hamburguesa (móvil) -->
        <button
            id="menu-btn"
            class="md:hidden text-fuse-navy"
            aria-label="Abrir menú"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
        </button>
    </nav>

    <!-- Menú móvil -->
    <div
        id="mobile-menu"
        class="hidden md:hidden bg-white border-t border-slate-100 px-6 py-4 space-y-3"
    >
        <a href="#hero" class="block text-fuse-navy font-medium">Inicio</a>
        <a href="#servicios" class="block text-fuse-navy font-medium"
            >Servicios</a
        >
        <a href="#portafolio" class="block text-fuse-navy font-medium"
            >Portafolio</a
        >
        <a href="#contacto" class="block text-fuse-navy font-medium">Contacto</a
        >
    </div>
</header>

<script>
    const btn = document.getElementById("menu-btn");
    const menu = document.getElementById("mobile-menu");
    btn?.addEventListener("click", () => {
        menu?.classList.toggle("hidden");
    });
</script>
